<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="600" MinWidth="600" MinHeight="400" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <GridSplitter HorizontalAlignment="Left" Width="5" Grid.Column="1"/>
        <Grid Background="#FFF8F8F8" MinHeight="50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="29"/>
                <RowDefinition/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>
            <TextBox TextWrapping="Wrap" VerticalAlignment="Center" Grid.ColumnSpan="3" Margin="39,8,8,0" Height="18"/>
            <ListBox Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.ColumnSpan="3" Margin="8,3,8,3"/>
            <TextBlock HorizontalAlignment="Left" Margin="8,8,0,0" TextWrapping="Wrap" VerticalAlignment="Top"><Run Text="Find:"/><LineBreak/><Run/></TextBlock>
            <Button Content="Add" Margin="8,0,3,8" Grid.Row="2" Height="25"/>
            <Button Content="Edit" Margin="3,0,3,8" Grid.Row="2" Grid.Column="1" Height="25"/>
            <Button Content="Remove" Margin="3,0,8,8" Grid.Row="2" Grid.Column="2" Height="27"/>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="108"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="27"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="22"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="22"/>
                <RowDefinition Height="24"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Label Content="Name:" HorizontalAlignment="Left" Width="152" VerticalAlignment="Center" Margin="6,3,0,3" Padding="0,0,0,0" VerticalContentAlignment="Bottom" Grid.Column="1" UseLayoutRounding="False"/>
            <TextBox x:Name="tbName" Margin="6,3,8,3" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="6,0,8,3" Grid.Column="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Height="18"/>
            <Label Content = "Phone Number:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,3,0,3" Grid.Row="2" Padding="0,0,0,0" UseLayoutRounding="True" Grid.Column="1"/>
            <TextBox x:Name="tbPhoneNumber" Margin="6,3,8,3" Grid.Row="3" TextWrapping="Wrap" VerticalAlignment="Top" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" ToolTip="+7-xxx-xxx-xx-xx" Padding="3,0,0,3" Grid.Column="1" Height="18"/>
            <Label Content = "Email:" HorizontalAlignment="Left" Width="152" VerticalAlignment="Top" Margin="6,3,0,3" Grid.Row="4" Padding="0,0,0,0"
                   Grid.Column="1"/>
            <TextBox x:Name="tbEmail" Margin="6,3,8,3" Grid.Row="5" TextWrapping="Wrap" VerticalAlignment="Top" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Padding="3,0,0,3" Grid.Column="1" Height="18"/>
            <Button HorizontalAlignment="Left" Margin="8,0,0,0" VerticalAlignment="Top" Height="100" RenderTransformOrigin="0.101,-0.848" Width="100" Grid.RowSpan="5" Grid.ColumnSpan="2" Grid.Row="1">
                <Button.Background>
                    <ImageBrush/>
                </Button.Background>
            </Button>
            <Button Grid.Column="1" Content="Apply" HorizontalAlignment="Left" Margin="3,50,0,0" Grid.Row="6" VerticalAlignment="Top" Width="75" Height="25"/>
        </Grid>

    </Grid>
</Window>
