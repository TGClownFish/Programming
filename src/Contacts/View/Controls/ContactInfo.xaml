<UserControl x:Class="View.Controls.ContactInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:View.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid 
        Grid.Column="2" 
        MinWidth="50">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="108"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Rectangle 
            HorizontalAlignment="Center" 
            Height="100" 
            Margin="8,3,3,0" 
            Grid.Row="1" 
            VerticalAlignment="Top" 
            Width="100" 
            Grid.RowSpan="5">
            <Rectangle.Fill>
                <ImageBrush ImageSource=
                        "../Resources/photo_placeholder_100x100.png"/>
            </Rectangle.Fill>
        </Rectangle>
        <Label 
            Content="Name:" 
            HorizontalAlignment="Left" 
            Width="152" 
            VerticalAlignment="Center" 
            Margin="3,8,0,3" 
            Padding="0" 
            VerticalContentAlignment="Bottom" 
            Grid.Column="1" 
            UseLayoutRounding="False"/>
        <TextBox 
            Margin="3,3,8,3" 
            Grid.Row="1" 
            TextWrapping="Wrap" 
            VerticalAlignment="Center" 
            Text="{Binding Path=SelectedContact.Name, 
                UpdateSourceTrigger=PropertyChanged}" 
            IsReadOnly="{Binding Path=IsReadOnly,
                UpdateSourceTrigger=PropertyChanged}"
            Grid.Column="1" 
            HorizontalContentAlignment="Stretch" 
            VerticalContentAlignment="Center" 
            Height="18"/>
        <Label 
            Content = "Phone Number:" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top" 
            Margin="3,3,0,3" 
            Grid.Row="2" 
            Padding="0" 
            UseLayoutRounding="True" 
            Grid.Column="1"/>
        <TextBox 
            Margin="3,3,8,3" 
            Grid.Row="3" 
            TextWrapping="Wrap" 
            VerticalAlignment="Top" 
            Text="{Binding Path=SelectedContact.PhoneNumber, 
                UpdateSourceTrigger=PropertyChanged}" 
            IsReadOnly="{Binding Path=IsReadOnly,
                UpdateSourceTrigger=PropertyChanged}"
            Padding="0" 
            Grid.Column="1" 
            Height="18"/>
        <Label 
            Content = "Email:" 
            HorizontalAlignment="Left" 
            Width="152" 
            VerticalAlignment="Top" 
            Margin="3,3,0,3" 
            Grid.Row="4" 
            Padding="0"
            Grid.Column="1"/>
        <TextBox 
            Margin="3,3,8,3" 
            Grid.Row="5" 
            TextWrapping="Wrap" 
            VerticalAlignment="Top" 
            Text="{Binding Path=SelectedContact.Email, 
                UpdateSourceTrigger=PropertyChanged}" 
            IsReadOnly= "{Binding Path=IsReadOnly,
                UpdateSourceTrigger=PropertyChanged}"
            Padding="0" 
            Grid.Column="1" 
            Height="18"/>
    </Grid>
</UserControl>
