    <!--</Control.Resources>-->
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Rectangle 
            HorizontalAlignment="Center" 
            Height="100" 
            Margin="8,3,3,0" 
            Grid.Row="1" 
            VerticalAlignment="Top" 
            Width="100" 
            Grid.RowSpan="5">
            <Rectangle.Fill>
                <ImageBrush ImageSource=
                        "../Resources/photo_placeholder_100x100.png"/>
            </Rectangle.Fill>
        </Rectangle>
        <Label 
            Content="Name:" 
            HorizontalAlignment="Left" 
            Width="152" 
            VerticalAlignment="Center" 
            Margin="3,8,0,3" 
            Padding="0" 
            VerticalContentAlignment="Bottom" 
            Grid.Column="1" 
            UseLayoutRounding="False"/>
        <TextBox 
            Margin="3,3,8,3" 
            Grid.Row="1" 
            TextWrapping="Wrap" 
            VerticalAlignment="Center" 
             
             Grid.Column="1" 
             HorizontalContentAlignment="Stretch" 
             VerticalContentAlignment="Center" 
            
             Height="18"
            Text="{Binding Path=Name, 
    UpdateSourceTrigger=PropertyChanged,
            ValidatesOnDataErrors=True}"
            IsReadOnly="{Binding Path=IsReadOnly,
   UpdateSourceTrigger=PropertyChanged}">
            <!--Text="{Binding Path=SelectedContact.Name, 
                UpdateSourceTrigger=PropertyChanged"-->
            
        </TextBox>
        <Label 
            Content = "Phone Number:" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top" 
            Margin="3,3,0,3" 
            Grid.Row="2" 
            Padding="0" 
            UseLayoutRounding="True" 
            Grid.Column="1"/>
        <TextBox 
            Margin="3,3,8,3" 
            Grid.Row="3" 
            TextWrapping="Wrap" 
            VerticalAlignment="Top" 
            
            Text="{Binding Path=SelectedContact.PhoneNumber, 
                UpdateSourceTrigger=PropertyChanged,
                ValidatesOnDataErrors=True}" 
            IsReadOnly="{Binding Path=IsReadOnly,
                UpdateSourceTrigger=PropertyChanged}"
            Padding="0" 
            Grid.Column="1" 
            Height="18"/>
        <Label 
            Content = "Email:" 
            HorizontalAlignment="Left" 
            Width="152" 
            VerticalAlignment="Top" 
            Margin="3,3,0,3" 
            Grid.Row="4" 
            Padding="0"
            Grid.Column="1"/>
        <TextBox 
            Margin="3,3,8,3" 
            Grid.Row="5" 
            TextWrapping="Wrap" 
            VerticalAlignment="Top" 
            
            Text="{Binding Path=SelectedContact.Email, 
                UpdateSourceTrigger=PropertyChanged}" 
            IsReadOnly= "{Binding Path=IsReadOnly,
                UpdateSourceTrigger=PropertyChanged,
                ValidatesOnDataErrors=True}" 
            Padding="0" 
            Grid.Column="1" 
            Height="18"/>
    </Grid>
</UserControl>
