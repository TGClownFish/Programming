<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        Title="Contact" 
        Height="400" 
        Width="600" 
        MinWidth="600" 
        MinHeight="400" 
        WindowStartupLocation="CenterScreen" Icon="/phone.png">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <GroupBox 
            Header="Edit Contact" 
            Grid.Column="0" 
            Margin="0,0,5,3">
            <StackPanel DataContext="{Binding CurentContact}">
                <Label 
                    Content="Name:"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center" 
                    Margin="3,0,0,3" 
                    Padding="0,5,5,5"/>
                <TextBox 
                    Margin="3" 
                    TextWrapping="Wrap" 
                    VerticalAlignment="Top" 
                    Text=
                    "{Binding Path=Name,
                    UpdateSourceTrigger=PropertyChanged}"/>
                <Label 
                    Content="Phone Number:" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Margin="3,3,0,3" 
                    Padding="0,5,5,5"
                    UseLayoutRounding="True"/>
                <TextBox 
                    Margin="3" 
                    TextWrapping="Wrap" 
                    VerticalAlignment="Top" 
                    Text=
                    "{Binding Path=PhoneNumber,
                    UpdateSourceTrigger=PropertyChanged}"/>
                <Label 
                    Content="Email:" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Margin="3,3,0,3" 
                    Padding="0,5,5,5"/>
                <TextBox 
                    Margin="3" 
                    TextWrapping="Wrap" 
                    VerticalAlignment="Top" 
                    Text=
                    "{Binding Path=Email, 
                    UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </GroupBox>
        <GroupBox 
            Header="Read Contact" 
            Margin="3,0,0,3" 
            Grid.Column="1">
            <StackPanel DataContext="{Binding CurentContact}">
                <Label 
                    Content="Name:" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center" 
                    Margin="3,3,0,3" />
                <Label 
                    Content="{Binding Path=Name}" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Margin="3,3,0,3" 
                    FontWeight="Bold" 
                    Padding="5,1,1,0" 
                    Height="18"/>
                <Label 
                    Content="Phone Number:" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Margin="3,3,0,3" />
                <Label 
                    Content="{Binding Path=PhoneNumber}" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Margin="3,3,0,3" 
                    FontWeight="Bold" 
                    Padding="5,1,1,0" 
                    Height="18"/>
                <Label 
                    Content="Email:" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Margin="3,3,0,3" />
                <Label 
                    Content="{Binding Path=Email}" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Margin="3,3,0,3" 
                    FontWeight="Bold" 
                    Padding="5,1,1,0" 
                    Height="18"/>
            </StackPanel>
        </GroupBox>
        <Button 
            Command="{Binding LoadCommand}" 
            Grid.Column="1" 
            Content="Load" 
            HorizontalAlignment="Right" 
            Grid.Row="1" 
            VerticalAlignment="Bottom" 
            Margin="3,3,15,15" 
            MinWidth="75" 
            MinHeight="25"/>
        <Button 
            Command="{Binding SaveCommand}" 
            Grid.Column="1" 
            Content="Save" 
            HorizontalAlignment="Right" 
            VerticalAlignment="Bottom" 
            MinWidth="75" 
            MinHeight="25" 
            Margin="0,3,98,15" 
            Grid.Row="1"/>
    </Grid>
</Window>
