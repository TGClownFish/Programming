<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:View"
        xmlns:Converters="clr-namespace:View.Converters"
        xmlns:Controls="clr-namespace:View.Controls"
        mc:Ignorable="d"
        Title="Contact" 
        Height="400" 
        Width="600" 
        MinWidth="600" 
        MinHeight="400" 
        WindowStartupLocation="CenterScreen" 
        Icon="Resources/ContactsApp_96x96.ico">
    <Window.Resources>
        <Converters:BoolToVisibilityConverter 
            x:Key="VisibilityConverter" />
        <DataTemplate x:Key="contactTemplate">
            <Grid Margin="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle 
                    Grid.Column="0" 
                    Width="30" 
                    Height="30" 
                    Margin="0,0,3,0">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource=
                            "Resources/photo_placeholder_30x30.png"/>
                    </Rectangle.Fill>
                </Rectangle>
                <StackPanel 
                    Grid.Column="1"
                    Margin="3,0,0,3">
                    <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{Binding Name}"/>
                    <TextBlock
                    FontSize="10"
                    Text="{Binding PhoneNumber}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction 
                Command="{Binding SaveCommand}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction 
                Command="{Binding LoadCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition 
                MinWidth="200"
                Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition 
                MinWidth="200"
                Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid 
            Background="#FFF8F8F8" 
            MinWidth="50">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <TextBox 
                TextWrapping="Wrap" 
                VerticalAlignment="Center" 
                Grid.ColumnSpan="3" 
                Margin="39,8,8,0" 
                Height="18"/>
            <Label
                Content="Find:"
                HorizontalAlignment="Left" 
                Margin="8,8,0,0"  
                VerticalAlignment="Top" 
                Padding="0,0,0,0" 
                VerticalContentAlignment="Center" 
                HorizontalContentAlignment="Center" />
            <ListBox 
                Grid.Row="1" 
                SelectedItem="{Binding Path=SelectedContact, 
                    UpdateSourceTrigger=PropertyChanged}" 
                ItemsSource= "{Binding Path=Contacts, 
                    UpdateSourceTrigger=PropertyChanged}" 
                Grid.ColumnSpan="3" 
                Margin="8,6,8,6" 
                IsSynchronizedWithCurrentItem="True" 
                ItemTemplate="{StaticResource contactTemplate}" />
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button 
                    Content="Add" 
                    Margin="8,0,3,8" 
                    Grid.Row="2" 
                    Height="25" 
                    Command="{Binding Path=AddCommand}"
                    IsEnabled="{Binding Path=IsReadOnly,
                        UpdateSourceTrigger=PropertyChanged}"/>
                <Button 
                    Content="Edit" 
                    Margin="3,0,3,8" 
                    Grid.Column="1" 
                    Grid.Row="2"
                    Height="25" 
                    IsEnabled= "{Binding Path=IsReadOnly, 
                        UpdateSourceTrigger=PropertyChanged}" 
                    Command="{Binding Path=EditCommand}"/>
                <Button 
                    Content="Remove" 
                    Margin="3,0,8,8" 
                    Grid.Column="2" 
                    Grid.Row="2"
                    Height="27" 
                    Command="{Binding Path=RemoveCommand}"
                    IsEnabled="{Binding Path=IsReadOnly,
                        UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Grid>

        <GridSplitter 
            HorizontalAlignment="Stretch" 
            Width="3" 
            Grid.Column="1" 
            Background="White" />
        
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Controls:ContactInfo Grid.Column="2"/>
        <Button 
                Grid.Column="2" 
                Content="Apply" 
                HorizontalAlignment="Left" 
                Margin="114,50,0,0" 
                Grid.Row="6" 
                VerticalAlignment="Top" 
                Width="75" 
                Height="25" 
                Command="{Binding Path=ApplyCommand}"
                Visibility="{Binding Path=IsReadOnly,
                    Converter={StaticResource VisibilityConverter}}"/>
        </Grid>
    </Grid>
</Window>